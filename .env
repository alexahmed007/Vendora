# ── Database (pick ONE; first match wins: Mongo > Postgres > MySQL > SQLite > JSON files) ──
MONGO_URL=mongodb+srv://macksyn:mygroqdatabase1234@groq.lm0dims.mongodb.net/Resella?retryWrites=true&w=majority&appName=Groq
# POSTGRES_URL=
# MYSQL_URL=
# DB_URL=./data/bot.sqlite

# ── Server / bot ──
PORT=8000
PREFIX=&
TIMEZONE=Africa/Lagos
LOG_LEVEL=silent

# ── Platform admin ──
# Your own number (digits, country code first). On first boot it is created automatically as the
# "control" tenant (no CLI step); only that account can run .admin commands, and new customers'
# pairing codes are sent to its chat.
ADMIN_NUMBER=2348089782988

# ── Menus ──
# MENU_DEBUG=true   logs every message that arrives while a menu is open (use if a reply is ignored)

# ── Vendor posts ──
# How long to wait for more photos / a caption before an item counts as complete
# ALBUM_QUIET_MS=20000
# A new post after a longer gap than this starts a new item (back-to-back products)
# ALBUM_BURST_MS=8000

# ── Posting ──
# PUBLISH_TICK_MS=5000
# MAX_MEDIA_PER_POST=6
# MAX_IMAGE_MB=10
# MAX_VIDEO_MB=25
# STATUS_AUDIENCE_MAX=800

# ── AI customer care (needs at least one provider; tried in this order) ──
# AI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_MAX_CONCURRENT=2
# AI_CUSTOMER_HOURLY_CAP=10
# AI_GROUP_PER_10_MIN=6
# AI_MAX_MESSAGE_AGE_MIN=30

# ── Capacity (tuned for a ~500MB host) ──
MAX_SESSIONS=3
SESSION_START_STAGGER_MS=4000
MEM_SOFT_MB=380
MEM_HARD_MB=460

# ── Presence (keeps the owner's phone notifications working) ──
# ALLOW_ONLINE_PRESENCE=false
# OFFLINE_REASSERT_MS=60000
