# ── Database (pick ONE; first match wins: Mongo > Postgres > MySQL > SQLite > JSON files) ──
# MONGO_URL=
  POSTGRES_URL=postgresql://u11i5hbtqtvcnvv0zcyx:zcI2Y5ieUlQX8XwMSqwX0H5kyfwwIs@btepfz18wnkeydwmhmfi-postgresql.services.clever-cloud.com:50013/btepfz18wnkeydwmhmfi
# MYSQL_URL=
# DB_URL=./data/bot.sqlite

# ── Server / bot ──
PORT=8000
PREFIX=&
TIMEZONE=Africa/Lagos
LOG_LEVEL=silent

# ── Platform admin ──
# Your own number (digits, country code first). Add it as the "control" tenant; only that
# account can run .admin commands, and new customers' pairing codes are sent to its chat.
ADMIN_NUMBER=2348089782988

# ── Menus ──
# auto = numbered text in your own chat, buttons elsewhere. Or force: buttons | numbered
# MENU_MODE=auto
# Comma-separated user ids that must always get quick-reply buttons (iPhone workaround)
# FORCE_BUTTON_USERS=

# ── Capacity (tuned for a ~500MB host) ──
MAX_SESSIONS=3
SESSION_START_STAGGER_MS=4000
MEM_SOFT_MB=380
MEM_HARD_MB=460

# ── Presence (keeps the owner's phone notifications working) ──
# ALLOW_ONLINE_PRESENCE=false
# OFFLINE_REASSERT_MS=60000
